{
	"name": "@oagent/monorepo",
	"version": "0.1.0",
	"private": true,
	"description": "MCP server that exposes OpenCode to Claude Code as a subagent (via ACP)",
	"license": "Apache-2.0",
	"packageManager": "pnpm@12.3.4",
	"scripts": {
		"dev": "pnpm --parallel -r dev",
		"check": "turbo run check",
		"format": "biome check --write",
		"build": "pnpm --filter oagent build",
		"ci:version": "changeset version",
		"ci:release": "changeset publish"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@changesets/cli": "^2.29.7",
		"@types/node": "^26.5.0",
		"turbo": "^2.9.14"
	}
}
